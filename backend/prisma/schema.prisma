generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SELLER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  payments       Payment[]
  activityLogs   ActivityLog[]
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  CASHIER
}

model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  products  Product[]
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  reference       String   @unique
  sku             String?  @unique
  categoryId      String   @db.ObjectId
  category        Category @relation(fields: [categoryId], references: [id])
  description     String?
  image           String?
  unit            String
  prixAchat       Float
  prixVenteDetail Float
  prixVenteGros   Float
  stockActuel     Float    @default(0)
  stockMinimum    Float    @default(0)
  stockMaximum    Float?
  fournisseurId   String?  @db.ObjectId
  fournisseur     Supplier? @relation(fields: [fournisseurId], references: [id])
  dateExpiration  DateTime?
  statut          String   @default("En stock")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  stockMovements  StockMovement[]
}

model Supplier {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  matriculeFiscal String?
  notes          String?
  
  purchases      Purchase[]
  products       Product[]
}

model Customer {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  company        String?
  phone          String?
  email          String?
  address        String?
  matriculeFiscal String?
  type           CustomerType
  creditLimit    Float?
  balance        Float    @default(0)
  notes          String?

  sales          Sale[]
  invoices       Invoice[]
  payments       Payment[]
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

model Purchase {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reference   String   @unique
  supplierId  String   @db.ObjectId
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  date        DateTime @default(now())
  total       Float
  discount    Float    @default(0)
  fees        Float    @default(0)
  finalTotal  Float
  status      PurchaseStatus @default(DRAFT)
  
  items       PurchaseItem[]
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId String   @db.ObjectId
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  price      Float
}

model Sale {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reference     String   @unique
  customerId    String?  @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id])
  type          SaleType
  subtotal      Float
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float
  paidAmount    Float    @default(0)
  paymentMethod PaymentMethod
  status        SaleStatus @default(COMPLETED)
  date          DateTime @default(now())

  items         SaleItem[]
  invoice       Invoice?
}

enum SaleType {
  RETAIL
  WHOLESALE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  CREDIT
}

model SaleItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  saleId     String   @db.ObjectId
  sale       Sale     @relation(fields: [saleId], references: [id])
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  price      Float
  discount   Float    @default(0)
  subtotal   Float
}

model Invoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reference     String   @unique
  saleId        String   @unique @db.ObjectId
  sale          Sale     @relation(fields: [saleId], references: [id])
  customerId    String?  @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id])
  date          DateTime @default(now())
  dueDate       DateTime?
  subtotal      Float
  tax           Float
  total         Float
  paidAmount    Float
  status        InvoiceStatus
  
  payments      Payment[]
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reference   String   @unique
  invoiceId   String?  @db.ObjectId
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  customerId  String?  @db.ObjectId
  customer    Customer? @relation(fields: [customerId], references: [id])
  amount      Float
  method      PaymentMethod
  date        DateTime @default(now())
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  notes       String?
}

model StockMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reference   String   @unique
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Float
  stockBefore Float
  stockAfter  Float
  reason      String?
  date        DateTime @default(now())
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  details     String?
  date        DateTime @default(now())
}

model Setting {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  companyName       String
  logo              String?
  address           String?
  phone             String?
  email             String?
  matriculeFiscal   String?
  currency          String   @default("DT")
  taxRate           Float    @default(19)
  allowNegativeStock Boolean @default(false)
}
